# Canonical template: apps/second-brain/.env.example
# Canonical local file: apps/second-brain/.env (untracked).
# This file is API runtime configuration only. The API Settings resolves this
# canonical file by absolute application path.
# Do not create a second authoritative service/.env.

SECOND_BRAIN_APP_ENV=development
SECOND_BRAIN_AUTH_MODE=development_headers
SECOND_BRAIN_BIND_HOST=127.0.0.1
SECOND_BRAIN_BIND_PORT=8000
SECOND_BRAIN_DATABASE_URL=postgresql+psycopg://second_brain_app:second_brain_app_dev@127.0.0.1:55439/second_brain
SECOND_BRAIN_STORAGE_BACKEND=filesystem
SECOND_BRAIN_STORAGE_ROOT=.second-brain-storage
SECOND_BRAIN_MAX_UPLOAD_BYTES=10000000
SECOND_BRAIN_MAX_REQUEST_ENVELOPE_BYTES=12000000
SECOND_BRAIN_REQUEST_BODY_TIMEOUT_SECONDS=10
SECOND_BRAIN_MAX_EXTRACTED_CHARS=2000000
SECOND_BRAIN_MAX_CHUNKS=5000
SECOND_BRAIN_MAX_PROCESSING_SECONDS=30
SECOND_BRAIN_URL_MAX_REDIRECTS=3
SECOND_BRAIN_URL_TIMEOUT_SECONDS=10
SECOND_BRAIN_MODEL_PROVIDER=fake
SECOND_BRAIN_MODEL_BASE_URL=http://127.0.0.1:8001/v1
SECOND_BRAIN_EMBEDDING_MODEL=text-embedding
SECOND_BRAIN_EMBEDDING_DIMENSIONS=8
SECOND_BRAIN_EMBEDDING_PROFILE_VERSION=1
# NULL is the fail-closed default for semantic-only Ask evidence. Set a
# calibrated cosine-similarity threshold in [-1.0, 1.0] only after evaluation.
# SECOND_BRAIN_ANSWER_MIN_SIMILARITY=
# Answer-provider keys are loaded by AnswerProviderSettings, not API Settings.
# Copying this file to `.env` with extra="forbid" must not include them.
# SECOND_BRAIN_ANSWER_API_KEY=
# SECOND_BRAIN_ANSWER_GENERATION_MODEL=grounded-answer
SECOND_BRAIN_POLICY_ENABLED=false

# Worker runtime configuration belongs in a separately permissioned environment
# file supplied only to `python -m second_brain.worker`. The API neither loads nor
# requires the dispatcher credential. Example worker-only keys:
# SECOND_BRAIN_WORKER_CONTENT_DATABASE_URL=postgresql+psycopg://second_brain_app:second_brain_app_dev@127.0.0.1:55439/second_brain
# SECOND_BRAIN_WORKER_DISPATCHER_DATABASE_URL=postgresql+psycopg://second_brain_worker:second_brain_worker_dev@127.0.0.1:55439/second_brain
# SECOND_BRAIN_WORKER_MODEL_PROVIDER=fake
# SECOND_BRAIN_WORKER_MODEL_BASE_URL=http://127.0.0.1:8001/v1
# SECOND_BRAIN_WORKER_MODEL_API_KEY=
# SECOND_BRAIN_WORKER_EMBEDDING_MODEL=text-embedding
# SECOND_BRAIN_WORKER_EMBEDDING_DIMENSIONS=8
# SECOND_BRAIN_WORKER_EMBEDDING_PROFILE_VERSION=1
# SECOND_BRAIN_WORKER_ANSWER_MIN_SIMILARITY=

# The API and worker embedding model, dimensions, profile version, and answer
# threshold form one profile and must match. Never change a threshold in place:
# calibrate it offline, increment both profile-version values, set the same
# threshold on both processes, then re-ingest to create embeddings under the new
# append-only profile. Until that is complete, semantic-only Ask fails closed.

# PostgreSQL bootstrap secrets and the Compose-published port are not service
# settings. Local development may use Compose's inline defaults. Overrides
# belong in an untracked `.env.compose.local` passed explicitly with
# `docker compose --env-file .env.compose.local ...`. Never export or load it
# into the API or worker process.

# Production requires AUTH_MODE=trusted_proxy and every setting below. The HMAC
# secret must contain at least 32 bytes of independently generated secret
# material. Keep all production values unset in development and never commit a
# real secret. Trusted proxy networks are bounded to at most 256 non-global
# addresses; use the narrowest private or loopback CIDR possible.
# SECOND_BRAIN_TRUSTED_PROXY_SECRET=
# SECOND_BRAIN_TRUSTED_PROXY_NETWORK=127.0.0.1/32
# SECOND_BRAIN_TRUSTED_ASSERTION_ISSUER=
# SECOND_BRAIN_TRUSTED_ASSERTION_AUDIENCE=second-brain
# SECOND_BRAIN_PUBLIC_ORIGIN=https://brain.example.test
# SECOND_BRAIN_SESSION_IDLE_SECONDS=1800
# SECOND_BRAIN_SESSION_ABSOLUTE_SECONDS=86400
# SECOND_BRAIN_EXCHANGE_RATE_LIMIT=20
# SECOND_BRAIN_EXCHANGE_RATE_WINDOW_SECONDS=60
