{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://acgs.local/schemas/authorization_trace.schema.json",
  "title": "ACGS Authorization Trace",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "workflow_scope",
    "evaluation_policy",
    "receipt"
  ],
  "properties": {
    "workflow_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workflow_id",
        "parent_workflow_id",
        "principal_chain"
      ],
      "properties": {
        "workflow_id": {
          "type": "string",
          "minLength": 1
        },
        "parent_workflow_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "principal_chain": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "principal_id",
              "role",
              "tenant",
              "delegated_at",
              "delegation_evidence_hash"
            ],
            "properties": {
              "principal_id": {
                "type": "string",
                "minLength": 1
              },
              "role": {
                "type": "string",
                "minLength": 1
              },
              "tenant": {
                "type": "string",
                "minLength": 1
              },
              "delegated_at": {
                "type": "string",
                "minLength": 1
              },
              "delegation_evidence_hash": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "evaluation_policy": {
      "type": "string",
      "enum": [
        "initiation-time",
        "access-time",
        "completion-time"
      ]
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receipt_hash",
        "audit_event_hash",
        "trace_id",
        "schema_version"
      ],
      "properties": {
        "receipt_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "audit_event_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "trace_id": {
          "type": "string",
          "minLength": 1
        },
        "schema_version": {
          "type": "string",
          "const": "v1"
        }
      }
    }
  }
}
