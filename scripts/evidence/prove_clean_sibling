def validate_run_semantics(run, node_id, parent, target, assignments, records, process_schedule):
    top_keys = {
        "schema_version",
        "node_version",
        "node_id",
        "parent_commit_sha",
        "product_commit_sha",
        "git_tree_sha",
        "assignment",
        "environment_identities",
        "pep660_editable_build",
        "ed25519_implementation",
        "commands",
        "selectors",
        "determinism",
        "clock",
        "platform",
        "artifacts",
        "skipped",
        "external",
        "timestamps",
    }
    exact_keys(run, top_keys, "run")
    if (
        run["schema_version"] != "acgs-run-evidence/v1"
        or run["node_version"] != 1
        or run["node_id"] != node_id
        or run["parent_commit_sha"] != parent
        or run["product_commit_sha"] != target
        or run["assignment"] != assignments
        or not is_sha(run["git_tree_sha"], 40)
    ):
        raise RuntimeError("trusted success status run binding mismatch")
    tokens = assignments.split("+")
    identities = run["environment_identities"]
    if not isinstance(identities, dict) or set(identities) != set(tokens) or "EVID" not in identities:
        raise RuntimeError("trusted success status environment set mismatch")
    for code, identity in identities.items():
        validate_environment_identity(code, identity, node_id)
    pep660 = run["pep660_editable_build"]
    exact_keys(pep660, {"distribution", "version", "module", "environments"}, "pep660 aggregate")
    expected_pep660_envs = {code for code in tokens if code in {"CP", "GZ"}}
    if (
        pep660["distribution"] != "editables"
        or pep660["version"] != "0.6"
        or pep660["module"] != "editables"
        or set(pep660["environments"]) != expected_pep660_envs
    ):
        raise RuntimeError("trusted success status pep660 aggregate mismatch")
    for code in expected_pep660_envs:
        aggregate = pep660["environments"][code]
        source = identities[code]["pep660_editable_build"]
        exact_keys(aggregate, {"module_path", "product_lock_sha256", "artifact_hashes"}, "pep660 env")
        if aggregate != {
            "module_path": source["module_path"],
            "product_lock_sha256": source["lock_sha256"],
            "artifact_hashes": source["artifact_hashes"],
        }:
            raise RuntimeError("trusted success status pep660 aggregate copied data mismatch")
    ed = run["ed25519_implementation"]
    exact_keys(ed, {"distribution", "version", "module", "evidence_test_lock_sha256", "artifact_hashes"}, "ed25519")
    if (
        ed["distribution"] != "cryptography"
        or ed["module"] != "cryptography.hazmat.primitives.asymmetric.ed25519"
        or not isinstance(ed["version"], str)
        or not is_sha(ed["evidence_test_lock_sha256"], 64)
        or not isinstance(ed["artifact_hashes"], list)
        or not ed["artifact_hashes"]
        or not all(is_sha(digest, 64) for digest in ed["artifact_hashes"])
    ):
        raise RuntimeError("trusted success status ed25519 binding mismatch")
    determinism = run["determinism"]
    exact_keys(determinism, {"seed", "python_hash_seed", "process_schedule"}, "determinism")
    if (
        determinism["seed"] != 20260710
        or determinism["python_hash_seed"] != "0"
        or determinism["process_schedule"] != process_schedule
    ):
        raise RuntimeError("trusted success status determinism mismatch")
    clock = run["clock"]
    exact_keys(clock, {"source", "skew_ms"}, "clock")
    if clock["source"] != "system-utc" or not isinstance(clock["skew_ms"], int):
        raise RuntimeError("trusted success status clock mismatch")
    platform = run["platform"]
    exact_keys(platform, {"os", "architecture", "container"}, "platform")
    exact_keys(platform["container"], {"kind", "identity"}, "container")
    if not all(isinstance(platform[name], str) and platform[name] for name in ("os", "architecture")):
        raise RuntimeError("trusted success status platform mismatch")
    if not all(isinstance(platform["container"][name], str) and platform["container"][name] for name in ("kind", "identity")):
        raise RuntimeError("trusted success status container mismatch")
    if run["skipped"] != [] or run["external"] != []:
        raise RuntimeError("trusted success status skipped/external mismatch")
    timestamps = run["timestamps"]
    exact_keys(
        timestamps,
        {"generated_at_utc", "transcript_started_at_utc", "transcript_finished_at_utc"},
        "timestamps",
    )
    if not all(is_utc(timestamps[name]) for name in timestamps):
        raise RuntimeError("trusted success status timestamps malformed")
    artifacts = run["artifacts"]
    if not isinstance(artifacts, list) or len(artifacts) != 2:
        raise RuntimeError("trusted success status artifact count mismatch")
    artifact_paths = set()
    required_suffixes = ("environment-identities.json", "transcript.jsonl")
    for index, artifact in enumerate(artifacts):
        exact_keys(artifact, {"path", "sha256"}, "artifact")
        if not is_abs(artifact["path"]) or not is_sha(artifact["sha256"], 64):
            raise RuntimeError("trusted success status artifact malformed")
        if artifact["path"] in artifact_paths or not artifact["path"].endswith(required_suffixes[index]):
            raise RuntimeError("trusted success status artifact path mismatch")
        artifact_paths.add(artifact["path"])
    commands = run["commands"]
    expected_command_selectors = EXPECTED_COMMAND_SELECTORS[node_id]
    if not isinstance(commands, list) or len(commands) != int(records):
        raise RuntimeError("trusted success status run record count mismatch")
    root_cwd = commands[0].get("cwd") if commands and isinstance(commands[0], dict) else None
    if not is_abs(root_cwd):
        raise RuntimeError("trusted success status root cwd mismatch")
    expected_cwd_by_scope = {
        "REPO_ROOT": root_cwd,
        "CP": f"{root_cwd}/packages/acgs-control-plane",
        "GZ": root_cwd,
        "UI": f"{root_cwd}/acgi-ai",
    }
    observed_selectors = []
    for index, command in enumerate(commands):
        if not isinstance(command, dict):
            raise RuntimeError("trusted success status command record mismatch")
        allowed = {
            "argv",
            "cwd",
            "exit_code",
            "stdout_sha256",
            "stderr_sha256",
            "started_at_utc",
            "finished_at_utc",
            "selectors",
        }
        if "cwd_scope" in command:
            allowed.add("cwd_scope")
        exact_keys(command, allowed, "command")
        if (
            not isinstance(command["argv"], list)
            or not command["argv"]
            or not is_abs(command["cwd"])
            or len(command["argv"]) > 256
            or any(
                not isinstance(argument, str)
                or not argument
                or len(argument) > 4096
                or any(ord(character) < 0x20 or ord(character) == 0x7F for character in argument)
                for argument in command["argv"]
            )
            or command["exit_code"] != 0
            or not is_sha(command["stdout_sha256"], 64)
            or not is_sha(command["stderr_sha256"], 64)
            or not is_utc(command["started_at_utc"])
            or not is_utc(command["finished_at_utc"])
            or command["finished_at_utc"] < command["started_at_utc"]
            or command["selectors"] != [expected_command_selectors[index]]
        ):
            raise RuntimeError("trusted success status command record mismatch")
        expected_argv = expected_command_argv(expected_command_selectors[index], index)
        if expected_argv is None or command["argv"] != expected_argv:
            raise RuntimeError("trusted success status command argv mismatch")
        if "cwd_scope" in command and command["cwd_scope"] not in {"REPO_ROOT", "CP", "GZ", "UI"}:
            raise RuntimeError("trusted success status command cwd mismatch")
        if "cwd_scope" in command:
            if command["cwd"] != expected_cwd_by_scope[command["cwd_scope"]]:
                raise RuntimeError("trusted success status command cwd mismatch")
        else:
            selector = command["selectors"][0]
            if selector.startswith("packages/acgs-control-plane:"):
                expected_cwd = expected_cwd_by_scope["CP"]
            elif selector.startswith("root:") or selector.startswith("packages/gove-zone:"):
                expected_cwd = expected_cwd_by_scope["REPO_ROOT"]
            else:
                raise RuntimeError("trusted success status command cwd mismatch")
            if command["cwd"] != expected_cwd:
                raise RuntimeError("trusted success status command cwd mismatch")
        if index == 0 and timestamps["transcript_started_at_utc"] != command["started_at_utc"]:
            raise RuntimeError("trusted success status transcript start mismatch")
        if index == len(commands) - 1 and timestamps["transcript_finished_at_utc"] != command["finished_at_utc"]:
            raise RuntimeError("trusted success status transcript finish mismatch")
        for selector in command["selectors"]:
            if selector not in observed_selectors:
                observed_selectors.append(selector)
    if run["selectors"] != observed_selectors:
        raise RuntimeError("trusted success status selector index mismatch")


def read_status_run(status_run_fd, expected_identity, expected_size, expected_sha256):
    if int(expected_size) > MAX_RUN_FD_BYTES:
        raise RuntimeError("trusted success status run descriptor exceeded 8MiB bound")
    st = os.fstat(status_run_fd)
    actual_identity = f"{st.st_dev}:{st.st_ino}:{st.st_uid}:{stat.S_IMODE(st.st_mode):o}"
    if (
        actual_identity != expected_identity
        or st.st_nlink != 0
        or st.st_size != int(expected_size)
    ):
        raise RuntimeError("trusted success status run descriptor mismatch")
    chunks = []
    remaining = int(expected_size)
    os.lseek(status_run_fd, 0, os.SEEK_SET)
    while remaining:
        chunk = os.read(status_run_fd, min(1024 * 1024, remaining))
        if not chunk:
            raise RuntimeError("trusted success status run descriptor truncated")
        chunks.append(chunk)
        remaining -= len(chunk)
    if os.read(status_run_fd, 1):
        raise RuntimeError("trusted success status run descriptor size mismatch")
    run_bytes = b"".join(chunks)
    if hashlib.sha256(run_bytes).hexdigest() != expected_sha256:
        raise RuntimeError("trusted success status run descriptor hash mismatch")
    return run_bytes


def verified_status(status_payload, status_run_fd):
    fields = status_payload.split(b"\0")
    if fields and fields[-1] == b"":
        fields = fields[:-1]
    if len(fields) != 8:
        raise RuntimeError("trusted success status metadata missing")
    (
        parent,
        target,
        run_hash,
        records,
        assignments,
        run_identity,
        run_size,
        run_sha256,
    ) = [
        field.decode("utf-8", "strict") for field in fields
    ]
    node_id = os.environ.get("NODE_ID", "P0-EVIDENCE-000")
    expected = EXPECTED_STATUS.get(node_id)
    if expected is None:
        raise RuntimeError("trusted success status node unsupported")
    expected_assignments, expected_records, expected_process_schedule = expected
    if parent != os.environ.get("P", "") or target != sys.argv[1]:
        raise RuntimeError("trusted success status target mismatch")
    if assignments != expected_assignments or records != expected_records:
        raise RuntimeError("trusted success status node contract mismatch")
    if not (len(run_hash) == 64 and all(ch in "0123456789abcdef" for ch in run_hash)):
        raise RuntimeError("trusted success status run hash malformed")
    try:
        run_bytes = read_status_run(status_run_fd, run_identity, run_size, run_sha256)
        run = json.loads(run_bytes)
    except Exception as exc:
        raise RuntimeError(f"trusted success status run JSON malformed: {exc}") from exc
    if not isinstance(run, dict):
        raise RuntimeError("trusted success status run JSON is not an object")
    validate_run_semantics(
        run, node_id, parent, target, assignments, records, expected_process_schedule
    )
    canonical = json.dumps(run, ensure_ascii=False, sort_keys=True, separators=(",", ":")).encode()
    if hashlib.sha256(canonical).hexdigest() != run_hash:
        raise RuntimeError("trusted success status run hash mismatch")
    return parent, target, run_hash, records, assignments


def verified_failure_status(status_payload, observed_exit_code):
    def reject_duplicate_object_pairs(pairs):
        parsed = {}
        for key, value in pairs:
            if key in parsed:
                raise ValueError("duplicate failure status field")
            parsed[key] = value
        return parsed

    try:
        status = json.loads(
            status_payload.decode("ascii", "strict"),
            object_pairs_hook=reject_duplicate_object_pairs,
        )
    except Exception:
