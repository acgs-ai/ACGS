def write_all(fd, data):
    view = memoryview(data)
    while view:
        written = os.write(fd, view)
        view = view[written:]


def canonical_failure_reason(message):
    text = str(message)
    safe = []
    for character in text[:512]:
        code = ord(character)
        if 0x20 <= code <= 0x7E and character not in "\r\n":
            safe.append(character)
        else:
            safe.append("?")
    return "".join(safe) or "unspecified failure"


def emit_failure(message, captured=b""):
    captured = captured[:MAX_FAILURE_CAPTURE_BYTES]
    captured_sha256 = hashlib.sha256(captured).hexdigest()
    captured_has_pass = PASS_MARKER in captured
    write_all(
        diagnostic_fd,
        (
            "CLEAN_SIBLING=FAIL phase=FINAL "
            f"reason={canonical_failure_reason(message)} "
            f"captured_bytes={len(captured)} "
            f"captured_sha256={captured_sha256} "
            f"captured_contains_pass={1 if captured_has_pass else 0}\n"
        ).encode("ascii"),
    )
    return 2


def validate_executable(path, label):
    st = os.lstat(path)
    if stat.S_ISLNK(st.st_mode) or not stat.S_ISREG(st.st_mode):
        raise RuntimeError(f"{label} is not a regular non-symlink")
    if st.st_uid != 0 or stat.S_IMODE(st.st_mode) & 0o022:
        raise RuntimeError(f"{label} ownership/mode is unsafe")
    if not os.access(path, os.X_OK):
        raise RuntimeError(f"{label} is not executable")


def fail_authenticated_runtime_unavailable():
    print(
        "CLEAN_SIBLING=FAIL phase=B0 reason=authenticated runtime bus unavailable",
        file=sys.stderr,
    )
    raise SystemExit(2)


def fail_authenticated_systemd_tooling_unavailable():
    print(
        "CLEAN_SIBLING=FAIL phase=B0 reason=authenticated systemd tooling unavailable",
        file=sys.stderr,
    )
    raise SystemExit(2)


def user_bus_env():
    uid = os.getuid()
    runtime = f"/run/user/{uid}"
    bus = f"{runtime}/bus"
    try:
        runtime_st = os.lstat(runtime)
    except OSError:
        fail_authenticated_runtime_unavailable()
    if (
        not stat.S_ISDIR(runtime_st.st_mode)
        or runtime_st.st_uid != uid
        or stat.S_IMODE(runtime_st.st_mode) & 0o077
    ):
        fail_authenticated_runtime_unavailable()
    try:
        bus_st = os.lstat(bus)
    except OSError:
        fail_authenticated_runtime_unavailable()
    if not stat.S_ISSOCK(bus_st.st_mode) or bus_st.st_uid != uid:
        fail_authenticated_runtime_unavailable()
    try:
        validate_executable(SYSTEMD_RUN, "systemd-run")
        validate_executable(SYSTEMCTL, "systemctl")
    except (OSError, RuntimeError):
        fail_authenticated_systemd_tooling_unavailable()
    return {
        "PATH": "/usr/bin:/bin",
        "HOME": "/dev/null",
        "XDG_RUNTIME_DIR": runtime,
        "DBUS_SESSION_BUS_ADDRESS": f"unix:path={bus}",
        "LC_ALL": "C.UTF-8",
        "LANG": "C.UTF-8",
    }


