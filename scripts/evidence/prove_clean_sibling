            if level == socket.SOL_SOCKET and cmsg_type == socket.SCM_RIGHTS:
                received = array.array("i")
                received.frombytes(
                    cmsg_data[: len(cmsg_data) - (len(cmsg_data) % received.itemsize)]
                )
                frame_fds.extend(received.tolist())
            else:
                unexpected_ancillary = True
        return frame_fds, unexpected_ancillary

    header = bytearray()
    while len(header) < 4:
        received = recv_status(4 - len(header))
        if received is None:
            if header:
                status_rejected = True
                status_frames.extend((b"", b""))
                status_frame_fd_counts.extend((0, 0))
            return status_rejected, status_frames, status_run_fds, status_frame_fd_counts, status_eof
        chunk, ancillary, flags, _address = received
        frame_fds = []
        frame_fds, unexpected_ancillary = parse_ancillary(ancillary)
        if flags & (socket.MSG_CTRUNC | socket.MSG_TRUNC) or ancillary or unexpected_ancillary:
            reject_with_fds(frame_fds)
            return status_rejected, status_frames, status_run_fds, status_frame_fd_counts, status_eof
        if not chunk:
            if not header:
                status_eof = True
            else:
                status_rejected = True
                status_frames.extend((b"", b""))
                status_frame_fd_counts.extend((0, 0))
            return status_rejected, status_frames, status_run_fds, status_frame_fd_counts, status_eof
        header.extend(chunk)

    frame_length = int.from_bytes(header, "big")
    if frame_length <= 0 or frame_length > MAX_STATUS_FRAME_BYTES:
        status_rejected = True
        status_frames.extend((b"", b""))
        status_frame_fd_counts.extend((0, 0))
        return status_rejected, status_frames, status_run_fds, status_frame_fd_counts, status_eof

    frame = bytearray()
    frame_fds = []
    unexpected_body_ancillary = False
    while len(frame) < frame_length:
        received = recv_status(frame_length - len(frame))
        if received is None:
            status_rejected = True
            close_received_status_fds(frame_fds)
            status_frames.extend((b"", b""))
            status_frame_fd_counts.append(len(frame_fds))
            status_frame_fd_counts.append(0)
            return status_rejected, status_frames, status_run_fds, status_frame_fd_counts, status_eof
