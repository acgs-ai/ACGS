#!/usr/bin/busybox ash
# shellcheck shell=sh
# Static entry boundary for the P0 clean-sibling proof.

set -eu

BUSYBOX=/usr/bin/busybox
BUSYBOX_SHA256=98d9040015eb17931e17b45e00b5f49f2451326372d5107a3a280f1cb3aaf3fc

fail() {
  "$BUSYBOX" printf '%s\n' "CLEAN_SIBLING=FAIL phase=B0 reason=$1" >&2
  exit 2
}

validated_fd_open() {
  path="$1"
  fd="$2"
  [ -f "$path" ] && [ ! -L "$path" ] || fail "trusted script is unavailable: $path"
  eval "exec $fd<\"\$path\""
  path_stat="$($BUSYBOX stat -Lc '%d:%i:%u:%a:%h' "$path")" ||
    fail "trusted script stat failed: $path"
  fd_stat="$($BUSYBOX stat -Lc '%d:%i:%u:%a:%h' "/proc/$$/fd/$fd")" ||
    fail "trusted script fd stat failed: $path"
  [ "$path_stat" = "$fd_stat" ] || fail "trusted script fd identity mismatch: $path"
  owner="${path_stat#*:*:}"
  owner="${owner%%:*}"
  [ "$owner" = "$($BUSYBOX id -u)" ] || fail "trusted script owner mismatch: $path"
  links="${path_stat##*:}"
  [ "$links" = 1 ] || fail "trusted script must be single-link: $path"
  mode="${path_stat%:*}"
  mode="${mode##*:}"
  group_writable=$((mode / 10 % 10))
  world_writable=$((mode % 10))
  [ $((group_writable & 2)) -eq 0 ] && [ $((world_writable & 2)) -eq 0 ] ||
    fail "trusted script must not be group/world writable: $path"
  digest="$($BUSYBOX sha256sum "/proc/$$/fd/$fd")"
  digest="${digest%% *}"
  eval "ACGS_FD_${fd}_PATH=\"\$path\""
  eval "ACGS_FD_${fd}_STAT=\"\$path_stat\""
  eval "ACGS_FD_${fd}_SHA256=\"\$digest\""
}

[ -x "$BUSYBOX" ] || fail 'trusted static BusyBox is unavailable'
[ ! -L "$BUSYBOX" ] || fail 'trusted static BusyBox must not be a symlink'
busybox_digest="$($BUSYBOX sha256sum "$BUSYBOX")"
busybox_digest="${busybox_digest%% *}"
[ "$busybox_digest" = "$BUSYBOX_SHA256" ] || fail 'trusted static BusyBox digest mismatch'
[ "$($BUSYBOX readlink -f /proc/$$/exe)" = "$BUSYBOX" ] ||
  fail 'entry interpreter is not trusted static BusyBox'
[ "$#" -eq 1 ] || fail 'usage: P=<reviewed-parent> scripts/evidence/prove_clean_sibling <exact-T-commit>'

launcher="$($BUSYBOX readlink -f "$0")"
repo="${launcher%/scripts/evidence/prove_clean_sibling}"
[ "$repo" != "$launcher" ] || fail 'launcher path is not canonical'
[ "$launcher" = "$repo/scripts/evidence/prove_clean_sibling" ] ||
  fail 'launcher must execute from its owning repository'
# Normalize the kernel-supplied script argv before the dynamic child is born.
# The child authenticates this exact parent argv in addition to its executable.
if [ "$0" != "$launcher" ]; then
  exec "$BUSYBOX" ash "$launcher" "$@"
fi
internal="$repo/scripts/evidence/prove_clean_sibling.sh"
[ -f "$internal" ] && [ ! -L "$internal" ] || fail 'internal prover is unavailable'
cleanup="$repo/scripts/evidence/clean_sibling_cleanup.sh"
uv_bin=/home/martin/.local/bin/uv

validated_fd_open "$launcher" 8
validated_fd_open "$internal" 9
validated_fd_open "$cleanup" 10
validated_fd_open "$uv_bin" 11

# Capture only the two reviewed caller inputs before replacing the entire
# environment. BusyBox is static, so hostile ELF-loader state cannot run while
# this boundary is being established. The dynamic Bash interpreter is loaded
# only by env -i below.
reviewed_parent="${P-}"
caller_tmpdir="${TMPDIR-/tmp}"
requested_node="${NODE_ID-P0-EVIDENCE-000}"
requested_target="$1"
case "$reviewed_parent" in
  '') fail 'P must be exported as the reviewed parent commit SHA' ;;
  *[!0123456789abcdef]*)
    fail 'P must be a lowercase 40-hex commit SHA'
    ;;
esac
[ "${#reviewed_parent}" -eq 40 ] || fail 'P must be a lowercase 40-hex commit SHA'
case "$requested_target" in
  '' | *[!0123456789abcdef]*)
    fail 'T commit is unavailable'
    ;;
esac
[ "${#requested_target}" -eq 40 ] || fail 'T commit is unavailable'
[ "$requested_target" != 0000000000000000000000000000000000000000 ] ||
  fail 'T commit is unavailable'
case "$requested_node:$reviewed_parent" in
  P0-EVIDENCE-000:26d11c2c7a8da37937a7c50c642f18edc75c9345 | \
    P1-MIGRATION-001:79a3c39f841cfc5a6c79e85973887814caf0e694 | \
    P1-SCOPE-002:40781e1200289507fcfbcedf6ab14c120ac6aae8 | \
