            reject_with_fds(frame_fds)
            return status_rejected, status_frames, status_run_fds, status_frame_fd_counts, status_eof
        frame.extend(chunk)
    if unexpected_body_ancillary:
        reject_with_fds(frame_fds)
        return status_rejected, status_frames, status_run_fds, status_frame_fd_counts, status_eof
    status_frames.append(bytes(frame))
    status_frame_fd_counts.append(len(frame_fds))
    status_run_fds.extend(frame_fds)

    extra = recv_status(1)
    if extra is None:
        return status_rejected, status_frames, status_run_fds, status_frame_fd_counts, status_eof
    chunk, ancillary, flags, _address = extra
    extra_fds, unexpected_ancillary = parse_ancillary(ancillary)
    if not chunk and not ancillary and not flags:
        status_eof = True
        return status_rejected, status_frames, status_run_fds, status_frame_fd_counts, status_eof
