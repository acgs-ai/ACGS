def build_child_env(systemd_env, ambient):
    child = dict(systemd_env)
    child["GIT_CONFIG_NOSYSTEM"] = "1"
    child["GIT_CONFIG_GLOBAL"] = "/dev/null"
    for key in ("P", "NODE_ID", "TMPDIR"):
        if key in ambient:
            child[key] = ambient[key]
    for key in CHILD_ACGS_ENV_ALLOWLIST:
        if key in ambient:
            child[key] = ambient[key]
    return child


def wait_for_pid(pid, timeout):
    deadline = time.monotonic() + timeout
    while True:
        waited_pid, status_value = os.waitpid(pid, os.WNOHANG)
        if waited_pid == pid:
            return status_value
        if time.monotonic() >= deadline:
            try:
                os.kill(pid, signal.SIGKILL)
            except ProcessLookupError:
                pass
            _, status_value = os.waitpid(pid, 0)
            return status_value
        time.sleep(0.05)


def kill_and_reap_pid(pid, timeout=2):
    try:
        os.kill(pid, signal.SIGKILL)
    except ProcessLookupError:
        pass
    return wait_for_pid(pid, timeout)


def exec_and_wait(argv, env, timeout=15):
    pid = os.fork()
    if pid == 0:
        try:
            os.execve(argv[0], argv, env)
        except BaseException:
            os._exit(127)
    status_value = wait_for_pid(pid, timeout)
    if os.WIFEXITED(status_value):
        return os.WEXITSTATUS(status_value)
    return 128 + os.WTERMSIG(status_value)


def exec_capture_and_wait(argv, env, timeout=15, max_bytes=65536):
    read_fd, write_fd = os.pipe()
    pid = None
    status_value = None

    def kill_and_reap_helper() -> None:
        nonlocal status_value
        if pid is None or status_value is not None:
            return
        try:
            waited_pid, candidate_status = os.waitpid(pid, os.WNOHANG)
        except ChildProcessError:
            status_value = 0
            return
        if waited_pid == pid:
            status_value = candidate_status
            return
        try:
            os.kill(pid, signal.SIGKILL)
        except ProcessLookupError:
            pass
        try:
            _, status_value = os.waitpid(pid, 0)
        except ChildProcessError:
            status_value = 0

    try:
        os.set_inheritable(read_fd, False)
        os.set_inheritable(write_fd, True)
        pid = os.fork()
        if pid == 0:
            try:
                os.close(read_fd)
                os.dup2(write_fd, 1)
                os.dup2(write_fd, 2)
                if write_fd not in (1, 2):
                    os.close(write_fd)
                os.execve(argv[0], argv, env)
            except BaseException:
                os._exit(127)
        os.close(write_fd)
        write_fd = None
        os.set_blocking(read_fd, False)
        deadline = time.monotonic() + timeout
        chunks = []
        total = 0
        eof = False
        try:
            while status_value is None or not eof:
                if status_value is None:
                    waited_pid, candidate_status = os.waitpid(pid, os.WNOHANG)
                    if waited_pid == pid:
                        status_value = candidate_status
                try:
                    chunk = os.read(read_fd, 4096)
                except BlockingIOError:
                    chunk = None
                if chunk == b"":
                    eof = True
                elif chunk:
                    total += len(chunk)
                    if total > max_bytes:
                        try:
                            os.kill(pid, signal.SIGKILL)
                        except ProcessLookupError:
                            pass
                        status_value = wait_for_pid(pid, 2) if status_value is None else status_value
                        raise RuntimeError("trusted systemctl show output is too large")
                    chunks.append(chunk)
                if time.monotonic() >= deadline:
                    try:
                        os.kill(pid, signal.SIGKILL)
                    except ProcessLookupError:
                        pass
                    status_value = wait_for_pid(pid, 2) if status_value is None else status_value
                    raise RuntimeError("trusted systemctl show timed out")
                if status_value is None or not eof:
                    time.sleep(0.02)
        except BaseException:
            kill_and_reap_helper()
            raise
        if os.WIFEXITED(status_value):
            exit_code = os.WEXITSTATUS(status_value)
        else:
            exit_code = 128 + os.WTERMSIG(status_value)
        return exit_code, b"".join(chunks)
    finally:
        if write_fd is not None:
            close_fd_quietly(write_fd)
        close_fd_quietly(read_fd)


def unit_cgroup_path(unit_name):
    uid = os.getuid()
    return f"/sys/fs/cgroup/user.slice/user-{uid}.slice/user@{uid}.service/app.slice/{unit_name}"


def verify_child_cgroup(pid, unit_name):
    expected_sysfs = unit_cgroup_path(unit_name)
    prefix = "/sys/fs/cgroup"
    if not expected_sysfs.startswith(prefix + "/"):
        raise RuntimeError("guardian systemd scope cgroup path is outside unified hierarchy")
    expected = expected_sysfs[len(prefix):]
    deadline = time.monotonic() + 10
    while time.monotonic() < deadline:
        try:
            cgroup = open(f"/proc/{pid}/cgroup", encoding="utf-8").read()
        except OSError:
            time.sleep(0.05)
            continue
        for line in cgroup.splitlines():
            fields = line.split(":", 2)
            if len(fields) == 3 and fields[0] == "0" and fields[1] == "":
                if fields[2] == expected:
                    return
        time.sleep(0.05)
    raise RuntimeError("guardian child did not enter exact systemd scope cgroup")


def verify_scope_tasks_max(pid, unit_name):
    uid = os.getuid()
    if (
        not unit_name.startswith(f"acgs-clean-sibling-{uid}-")
        or not unit_name.endswith(".scope")
        or "/" in unit_name
        or unit_name in {".", ".."}
        or any(ord(character) < 0x21 or ord(character) == 0x7F for character in unit_name)
    ):
        raise RuntimeError("guardian systemd scope unit name is invalid")
    components = (
        "user.slice",
        f"user-{uid}.slice",
        f"user@{uid}.service",
        "app.slice",
        unit_name,
    )

    class Statfs(ctypes.Structure):
        _fields_ = [
            ("f_type", ctypes.c_long),
            ("f_bsize", ctypes.c_long),
            ("f_blocks", ctypes.c_ulong),
            ("f_bfree", ctypes.c_ulong),
            ("f_bavail", ctypes.c_ulong),
            ("f_files", ctypes.c_ulong),
            ("f_ffree", ctypes.c_ulong),
            ("f_fsid", ctypes.c_int * 2),
            ("f_namelen", ctypes.c_long),
            ("f_frsize", ctypes.c_long),
            ("f_flags", ctypes.c_long),
            ("f_spare", ctypes.c_long * 4),
        ]

    def verify_cgroup2_fd(fd):
        statfs = Statfs()
        local_libc = ctypes.CDLL(None, use_errno=True)
        if local_libc.fstatfs(fd, ctypes.byref(statfs)) != 0:
            raise OSError(ctypes.get_errno(), "guardian cgroup statfs failed")
        if statfs.f_type != CGROUP2_SUPER_MAGIC:
            raise RuntimeError("guardian systemd scope is not on cgroup2")

    def verify_cgroup_dir_fd(fd, label, expected_dev=None):
        st = os.fstat(fd)
        if not stat.S_ISDIR(st.st_mode):
            raise RuntimeError(f"guardian cgroup component is not a directory: {label}")
        if st.st_uid not in (0, uid) or stat.S_IMODE(st.st_mode) & 0o022:
            raise RuntimeError(f"guardian cgroup component ownership/mode is unsafe: {label}")
        if expected_dev is not None and st.st_dev != expected_dev:
            raise RuntimeError(f"guardian cgroup component device mismatch: {label}")
        verify_cgroup2_fd(fd)
        return st

    def open_cgroup_dir_at(parent_fd, name):
        return os.open(
            name,
            os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC | os.O_NOFOLLOW,
            dir_fd=parent_fd,
        )

    def verify_cgroup_file_fd(fd, label, expected_dev):
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode):
            raise RuntimeError(f"guardian systemd scope {label} is not a regular file")
        if st.st_uid not in (0, uid) or stat.S_IMODE(st.st_mode) & 0o022 or st.st_dev != expected_dev:
            raise RuntimeError(f"guardian systemd scope {label} metadata is unsafe")

    def read_cgroup_file(fd, label):
        chunks = []
        total = 0
        while True:
            try:
                chunk = os.read(fd, 64 - total + 1)
            except OSError as exc:
                raise RuntimeError(f"guardian systemd scope {label} is unreadable") from exc
            if not chunk:
                return b"".join(chunks)
            chunks.append(chunk)
            total += len(chunk)
            if total > 64:
                raise RuntimeError(f"guardian systemd scope {label} is overlong")

    def read_scope_file(scope_fd, label, expected_dev):
        try:
            fd = os.open(label, os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW, dir_fd=scope_fd)
        except OSError as exc:
            raise RuntimeError(f"guardian systemd scope {label} is unavailable") from exc
        try:
            verify_cgroup_file_fd(fd, label, expected_dev)
            return read_cgroup_file(fd, label)
        finally:
            os.close(fd)

    def open_scope_file(scope_fd, label, flags, expected_dev):
        try:
            fd = os.open(label, flags | os.O_CLOEXEC | os.O_NOFOLLOW, dir_fd=scope_fd)
        except OSError as exc:
            raise RuntimeError(f"guardian systemd scope {label} is unavailable") from exc
        try:
            verify_cgroup_file_fd(fd, label, expected_dev)
        except BaseException:
            os.close(fd)
            raise
        return fd

    path = unit_cgroup_path(unit_name)
    try:
        root_fd = os.open("/sys/fs/cgroup", os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC | os.O_NOFOLLOW)
    except OSError as exc:
        raise RuntimeError("guardian cgroup root is unavailable") from exc
    opened = [root_fd]
    scope_fd = None
    try:
        root_st = verify_cgroup_dir_fd(root_fd, "/sys/fs/cgroup")
        parent_fd = root_fd
        for component in components:
            try:
                child_fd = open_cgroup_dir_at(parent_fd, component)
            except OSError as exc:
                raise RuntimeError("guardian systemd scope cgroup directory is unavailable") from exc
            opened.append(child_fd)
            child_st = verify_cgroup_dir_fd(child_fd, component, root_st.st_dev)
            parent_fd = child_fd
        scope_fd = opened[-1]
        scope_identity = (child_st.st_dev, child_st.st_ino)
        raw_max = read_scope_file(scope_fd, "pids.max", root_st.st_dev)
        raw_current = read_scope_file(scope_fd, "pids.current", root_st.st_dev)
        if raw_max != b"512\n":
            raise RuntimeError("guardian systemd scope pids.max must be exactly 512")
        if not (
            raw_current == b"0\n"
            or (
                raw_current.endswith(b"\n")
                and raw_current[:-1].isdigit()
                and not raw_current.startswith(b"0")
            )
        ):
            raise RuntimeError("guardian systemd scope pids.current must be a canonical integer")
        if int(raw_current) > EXPECTED_SCOPE_TASKS_MAX:
            raise RuntimeError("guardian systemd scope pids.current exceeds pids.max")
        verify_child_cgroup(pid, unit_name)
        current_scope_st = os.fstat(scope_fd)
        if (current_scope_st.st_dev, current_scope_st.st_ino) != scope_identity or path != unit_cgroup_path(unit_name):
            raise RuntimeError("guardian systemd scope cgroup identity changed")
        retained = {"identity": scope_identity}
        try:
            retained["scope_fd"] = os.dup(scope_fd)
            os.set_inheritable(retained["scope_fd"], False)
            retained["kill_fd"] = open_scope_file(scope_fd, "cgroup.kill", os.O_WRONLY, root_st.st_dev)
            os.set_inheritable(retained["kill_fd"], False)
            retained["events_fd"] = open_scope_file(scope_fd, "cgroup.events", os.O_RDONLY, root_st.st_dev)
            os.set_inheritable(retained["events_fd"], False)
            retained["pids_max_fd"] = open_scope_file(scope_fd, "pids.max", os.O_RDONLY, root_st.st_dev)
            os.set_inheritable(retained["pids_max_fd"], False)
            retained["pids_current_fd"] = open_scope_file(scope_fd, "pids.current", os.O_RDONLY, root_st.st_dev)
            os.set_inheritable(retained["pids_current_fd"], False)
        except BaseException:
            close_retained_scope(retained)
            raise
        return retained
    finally:
        for fd in reversed(opened):
            os.close(fd)


def verify_systemd_scope_properties(unit_name, env):
    properties = list(EXPECTED_SYSTEMD_SCOPE_PROPERTIES)
    argv = [SYSTEMCTL, "--user", "show", unit_name]
    for property_name in properties:
        argv.append(f"--property={property_name}")
    exit_code, output = exec_capture_and_wait(argv, env, timeout=15, max_bytes=16384)
    if exit_code != 0:
        raise RuntimeError("guardian systemd scope property query failed")
    decoded = output.decode("ascii", "strict")
    observed = {}
    for line in decoded.splitlines():
        if not line or "=" not in line:
            raise RuntimeError("guardian systemd scope property output is malformed")
        key, value = line.split("=", 1)
        if key in observed:
            raise RuntimeError("guardian systemd scope property output is duplicated")
        observed[key] = value
    for key, expected_values in EXPECTED_SYSTEMD_SCOPE_PROPERTIES.items():
        if observed.get(key) not in expected_values:
            raise RuntimeError(f"guardian systemd scope property mismatch: {key}")


def parse_systemctl_show_properties(output, expected_properties):
    decoded = output.decode("ascii", "strict")
    observed = {}
    expected = set(expected_properties)
    for line in decoded.splitlines():
        if not line or "=" not in line:
            raise RuntimeError("guardian systemd scope state output is malformed")
        key, value = line.split("=", 1)
        if key in observed:
            raise RuntimeError("guardian systemd scope state output is duplicated")
        if key not in expected:
            raise RuntimeError("guardian systemd scope state output is unexpected")
        observed[key] = value
    if set(observed) != expected:
        raise RuntimeError("guardian systemd scope state output is incomplete")
    return observed


def query_scope_state(unit_name, env):
    properties = ("LoadState", "ActiveState", "InvocationID", "ControlGroup")
    argv = [SYSTEMCTL, "--user", "show", unit_name]
    for property_name in properties:
        argv.append(f"--property={property_name}")
    exit_code, output = exec_capture_and_wait(argv, env, timeout=15, max_bytes=16384)
    if exit_code != 0:
        raise RuntimeError("guardian systemd scope state query failed")
    return parse_systemctl_show_properties(output, properties)


def expected_scope_control_group(unit_name):
    prefix = "/sys/fs/cgroup"
    path = unit_cgroup_path(unit_name)
    if not path.startswith(prefix + "/"):
        raise RuntimeError("guardian systemd scope cgroup path is outside unified hierarchy")
    return path[len(prefix):]


def active_scope_identity_from_state(unit_name, state):
    invocation_id = state["InvocationID"]
    control_group = state["ControlGroup"]
    if state["LoadState"] != "loaded" or state["ActiveState"] != "active":
        raise RuntimeError("guardian systemd scope is not active")
    if len(invocation_id) != 32 or any(character not in "0123456789abcdef" for character in invocation_id):
        raise RuntimeError("guardian systemd scope InvocationID is malformed")
    if control_group != expected_scope_control_group(unit_name):
        raise RuntimeError("guardian systemd scope ControlGroup mismatch")
    return invocation_id, control_group


def capture_initial_scope_identity(unit_name, env, cgroup_identity):
    state = query_scope_state(unit_name, env)
    invocation_id, control_group = active_scope_identity_from_state(unit_name, state)
    return {
        "invocation_id": invocation_id,
        "control_group": control_group,
        "cgroup": cgroup_identity,
    }


def capture_verified_scope_readiness(unit_name, env, cgroup_identity, child_pid):
    properties = tuple(EXPECTED_SYSTEMD_SCOPE_PROPERTIES) + (
        "LoadState",
        "ActiveState",
        "InvocationID",
        "ControlGroup",
    )
    argv = [SYSTEMCTL, "--user", "show", unit_name]
    for property_name in properties:
        argv.append(f"--property={property_name}")
    exit_code, output = exec_capture_and_wait(argv, env, timeout=15, max_bytes=32768)
    if exit_code != 0:
        raise RuntimeError("guardian systemd scope readiness query failed")
    observed = parse_systemctl_show_properties(output, properties)
    for key, expected_values in EXPECTED_SYSTEMD_SCOPE_PROPERTIES.items():
        if observed.get(key) not in expected_values:
            raise RuntimeError(f"guardian systemd scope property mismatch: {key}")
    invocation_id, control_group = active_scope_identity_from_state(unit_name, observed)
    if retained_scope_identity(cgroup_identity) != cgroup_identity["identity"]:
        raise RuntimeError("guardian retained cgroup identity changed before release")
    if read_retained_cgroup_file(cgroup_identity["pids_max_fd"], "pids.max") != b"512\n":
        raise RuntimeError("guardian systemd scope pids.max changed before release")
    verify_child_cgroup(child_pid, unit_name)
    return {
        "invocation_id": invocation_id,
        "control_group": control_group,
        "cgroup": cgroup_identity,
    }


def scope_cgroup_absent_repeated(unit_name):
    path = unit_cgroup_path(unit_name)
    for index in range(2):
        if os.path.exists(path):
            return False
        if index == 0:
            time.sleep(0.05)
    return True


def scope_state_is_collected_absent(unit_name, state):
    if state["LoadState"] != "not-found" or state["ActiveState"] != "inactive":
        return False
    if state["InvocationID"] or state["ControlGroup"]:
        raise RuntimeError("guardian systemd scope replacement identity is present")
    return scope_cgroup_absent_repeated(unit_name)


class RetainedCgroupUnreadable(RuntimeError):
    def __init__(self, label, error_number):
        super().__init__(f"guardian retained cgroup {label} is unreadable")
        self.label = label
        self.errno = error_number


def read_retained_cgroup_file(fd, label):
    try:
        os.lseek(fd, 0, os.SEEK_SET)
        chunks = []
        total = 0
        while True:
            chunk = os.read(fd, 4096 - total + 1)
            if not chunk:
                return b"".join(chunks)
            chunks.append(chunk)
            total += len(chunk)
            if total > 4096:
                raise RuntimeError(f"guardian retained cgroup {label} is overlong")
    except OSError as exc:
        raise RetainedCgroupUnreadable(label, exc.errno) from exc


def parse_retained_cgroup_integer(raw, label):
    if not raw.endswith(b"\n"):
        raise RuntimeError(f"guardian retained cgroup {label} is not newline terminated")
    value = raw[:-1]
    if not value.isdigit() or (len(value) > 1 and value.startswith(b"0")):
        raise RuntimeError(f"guardian retained cgroup {label} is not a canonical integer")
    return int(value)


def retained_cgroup_events_populated_zero(raw):
    observed = {}
    known_keys = {b"populated", b"frozen"}
    if not raw.endswith(b"\n"):
        raise RuntimeError("guardian retained cgroup cgroup.events is not newline terminated")
    for line in raw.splitlines():
        fields = line.split(b" ")
        if len(fields) != 2:
            raise RuntimeError("guardian retained cgroup cgroup.events is malformed")
        key = fields[0]
        value = fields[1]
        if key not in known_keys:
            raise RuntimeError("guardian retained cgroup cgroup.events has unknown key")
        if key in observed:
            raise RuntimeError("guardian retained cgroup cgroup.events has duplicate keys")
        if value not in (b"0", b"1"):
            raise RuntimeError("guardian retained cgroup cgroup.events has noncanonical value")
        observed[key] = int(value)
    if b"populated" not in observed:
        raise RuntimeError("guardian retained cgroup cgroup.events missing populated")
    return observed[b"populated"] == 0


def retained_scope_identity(scope):
    st = os.fstat(scope["scope_fd"])
    return (st.st_dev, st.st_ino)


def prove_retained_scope_collected_absent(scope, unreadable):
    if unreadable.errno != errno.ENODEV:
        raise unreadable
    scope_st = os.fstat(scope["scope_fd"])
    if (scope_st.st_dev, scope_st.st_ino) != scope["identity"] or scope_st.st_nlink != 0:
        raise unreadable
    for key in ("scope_fd", "pids_current_fd", "pids_max_fd", "events_fd", "kill_fd"):
        fd_st = os.fstat(scope[key])
        if fd_st.st_nlink != 0:
            raise unreadable
    try:
        state = query_scope_state(unit_name, systemd_env)
    except RuntimeError as query_exc:
        raise unreadable from query_exc
    try:
        collected_absent = scope_state_is_collected_absent(unit_name, state)
    except RuntimeError as state_exc:
        raise unreadable from state_exc
    if not collected_absent:
        raise unreadable


def kill_and_drain_retained_scope(scope):
    if retained_scope_identity(scope) != scope["identity"]:
        raise RuntimeError("guardian retained cgroup identity changed before kill")
    try:
        current = read_retained_cgroup_file(scope["pids_current_fd"], "pids.current")
        if parse_retained_cgroup_integer(current, "pids.current") != 0:
            write_all(scope["kill_fd"], b"1")
    except OSError as exc:
        raise RuntimeError("guardian retained cgroup.kill failed") from exc
    deadline = time.monotonic() + 30
    while time.monotonic() < deadline:
        if retained_scope_identity(scope) != scope["identity"]:
            raise RuntimeError("guardian retained cgroup identity changed while draining")
        current = read_retained_cgroup_file(scope["pids_current_fd"], "pids.current")
        events = read_retained_cgroup_file(scope["events_fd"], "cgroup.events")
        if (
            parse_retained_cgroup_integer(current, "pids.current") == 0
            and retained_cgroup_events_populated_zero(events)
        ):
            return
        time.sleep(0.1)
    raise RuntimeError("guardian retained cgroup did not drain")


def close_retained_scope(scope):
    if not isinstance(scope, dict):
        return
    for key in ("pids_current_fd", "pids_max_fd", "events_fd", "kill_fd", "scope_fd"):
        fd = scope.get(key)
        if isinstance(fd, int):
            close_fd_quietly(fd)


def apply_child_limits():
    resource.setrlimit(
        resource.RLIMIT_FSIZE,
        (TRUSTED_QUOTA_SETUP_FSIZE_BYTES, TRUSTED_QUOTA_SETUP_FSIZE_BYTES),
    )
    resource.setrlimit(resource.RLIMIT_AS, (GUARDIAN_ADDRESS_SPACE_BYTES, GUARDIAN_ADDRESS_SPACE_BYTES))
    resource.setrlimit(resource.RLIMIT_CPU, (GUARDIAN_CPU_SECONDS, GUARDIAN_CPU_SECONDS))
    resource.setrlimit(resource.RLIMIT_NOFILE, (256, 256))
    resource.setrlimit(resource.RLIMIT_CORE, (0, 0))


def read_pipe_into_memfd(pipe_fd, limit):
    total = 0
    overflow = False
    while True:
        try:
            chunk = os.read(pipe_fd, 1024 * 1024)
        except BlockingIOError:
            break
        if not chunk:
            return total, overflow, True
        if total + len(chunk) > limit:
            remaining = limit - total
            if remaining > 0:
                write_all(memfd, chunk[:remaining])
                total += remaining
            overflow = True
            break
        write_all(memfd, chunk)
        total += len(chunk)
    return total, overflow, False


def fd_mode_octal(fd):
    return format(stat.S_IMODE(os.fstat(fd).st_mode), "o")


def fd_identity_for_env(fd):
    st = os.fstat(fd)
    return f"{st.st_dev}:{st.st_ino}:{st.st_uid}:{fd_mode_octal(fd)}:{st.st_size}"


def authenticated_fd_stat_for_env(fd):
    st = os.fstat(fd)
    return f"{st.st_dev}:{st.st_ino}:{st.st_uid}:{stat.S_IMODE(st.st_mode):o}:{st.st_nlink}"


def sha256_fd(fd, limit, expected_size=None):
    size = os.fstat(fd).st_size
    if size > limit:
        raise RuntimeError("trusted snapshot artifact exceeded 64MiB bound")
    if expected_size is not None and size != expected_size:
        raise RuntimeError("trusted snapshot artifact size mismatch")
    digest = hashlib.sha256()
    total = 0
    offset = 0
    while total < size:
        chunk = os.pread(fd, min(1024 * 1024, size - total), offset)
        if not chunk:
            raise RuntimeError("trusted snapshot artifact truncated")
        total += len(chunk)
        offset += len(chunk)
        digest.update(chunk)
    if total != size:
        raise RuntimeError("trusted snapshot artifact read count mismatch")
    return digest.hexdigest()


def sealed_memfd_snapshot_from_fd(label, source_fd):
    prefix = f"ACGS_CLEAN_SIBLING_{label.upper()}"
    expected_path = os.environ.get(f"{prefix}_PATH", "")
    expected_stat = os.environ.get(f"{prefix}_STAT", "")
    expected_sha256 = os.environ.get(f"{prefix}_SHA256", "")
    if not expected_path or not expected_stat or not expected_sha256:
        raise RuntimeError(f"trusted {label} snapshot metadata missing")
    source_path = os.path.realpath(f"/proc/{os.getpid()}/fd/{source_fd}")
    if source_path != expected_path:
        raise RuntimeError(f"trusted {label} snapshot source path changed")
    if authenticated_fd_stat_for_env(source_fd) != expected_stat:
        raise RuntimeError(f"trusted {label} snapshot source identity changed")
    source_size = os.fstat(source_fd).st_size
    if source_size > MAX_SNAPSHOT_ARTIFACT_BYTES:
        raise RuntimeError("trusted snapshot artifact exceeded 64MiB bound")
    source_sha256 = sha256_fd(source_fd, MAX_SNAPSHOT_ARTIFACT_BYTES, source_size)
    if source_sha256 != expected_sha256:
        raise RuntimeError(f"trusted {label} snapshot source digest changed")
    snapshot_fd = os.memfd_create(
        f"acgs-clean-sibling-{label}-snapshot",
        os.MFD_ALLOW_SEALING | getattr(os, "MFD_CLOEXEC", 0),
    )
    total = 0
    offset = 0
    while total < source_size:
        chunk = os.pread(source_fd, min(1024 * 1024, source_size - total), offset)
        if not chunk:
            raise RuntimeError(f"trusted {label} snapshot source truncated")
        total += len(chunk)
        offset += len(chunk)
        write_all(snapshot_fd, chunk)
    if total != source_size:
        raise RuntimeError(f"trusted {label} snapshot copy count mismatch")
    os.lseek(source_fd, 0, os.SEEK_SET)
    os.lseek(snapshot_fd, 0, os.SEEK_SET)
    if os.fstat(snapshot_fd).st_size != source_size:
        raise RuntimeError(f"trusted {label} snapshot size mismatch")
    if sha256_fd(snapshot_fd, MAX_SNAPSHOT_ARTIFACT_BYTES, source_size) != expected_sha256:
        raise RuntimeError(f"trusted {label} snapshot digest mismatch")
    fcntl.fcntl(snapshot_fd, F_ADD_SEALS, REQUIRED_SEALS)
    if fcntl.fcntl(snapshot_fd, F_GET_SEALS) != REQUIRED_SEALS:
        raise RuntimeError(f"trusted {label} snapshot seal mismatch")
    os.set_inheritable(snapshot_fd, True)
    return {
        "fd": snapshot_fd,
        "stat": fd_identity_for_env(snapshot_fd),
    }


def build_sealed_snapshot_artifacts():
    artifacts = {}
    os.environ["ACGS_CLEAN_SIBLING_SNAPSHOT_MODE"] = "anonymous"
    for label, fd in SNAPSHOT_ARTIFACTS:
        snapshot = sealed_memfd_snapshot_from_fd(label, fd)
        artifacts[label] = snapshot
        prefix = f"ACGS_CLEAN_SIBLING_{label.upper()}"
        os.environ[f"{prefix}_SNAPSHOT_FD"] = str(snapshot["fd"])
        os.environ[f"{prefix}_SNAPSHOT_STAT"] = snapshot["stat"]
    return artifacts


def read_memfd():
    os.lseek(memfd, 0, os.SEEK_SET)
    captured = b""
    while True:
        chunk = os.read(memfd, 1024 * 1024)
        if not chunk:
            break
        captured += chunk
        if len(captured) > MAX_VISIBLE_OUTPUT_BYTES:
            raise RuntimeError("visible output memfd exceeded 64MiB bound")
    return captured


def seal_and_read_memfd():
    os.lseek(memfd, 0, os.SEEK_END)
    size = os.lseek(memfd, 0, os.SEEK_CUR)
    seals = fcntl.fcntl(memfd, F_GET_SEALS)
    if seals != REQUIRED_SEALS:
        fcntl.fcntl(memfd, F_ADD_SEALS, REQUIRED_SEALS)
        seals = fcntl.fcntl(memfd, F_GET_SEALS)
    if seals != REQUIRED_SEALS:
        raise RuntimeError(f"visible output memfd seals mismatch: {seals}")
    if size:
        try:
            mmap.mmap(memfd, size, flags=mmap.MAP_SHARED, prot=mmap.PROT_WRITE)
        except OSError:
            pass
        else:
            raise RuntimeError("visible output memfd accepted writable mmap after sealing")
    captured = read_memfd()
    if PASS_MARKER in captured:
        raise RuntimeError("subordinate proof output attempted to emit technical PASS")
    return captured


def close_fd_quietly(fd):
    if fd is None:
        return
    try:
        os.close(fd)
    except OSError:
        pass


def is_sha(value, length):
    return isinstance(value, str) and len(value) == length and all(
        ch in "0123456789abcdef" for ch in value
    )


def is_abs(value):
    return isinstance(value, str) and value.startswith("/") and len(value) > 1


def is_utc(value):
    if not isinstance(value, str) or len(value) != 20 or value[-1] != "Z":
        return False
    return (
        value[0:4].isdigit()
        and value[4] == "-"
        and value[5:7].isdigit()
        and value[7] == "-"
        and value[8:10].isdigit()
        and value[10] == "T"
        and value[11:13].isdigit()
        and value[13] == ":"
        and value[14:16].isdigit()
        and value[16] == ":"
        and value[17:19].isdigit()
    )


def exact_keys(value, keys, label):
    if not isinstance(value, dict) or set(value) != set(keys):
        raise RuntimeError(f"trusted success status {label} shape mismatch")


def validate_lock(value, *, ui=False):
    keys = {"path", "sha256"} if ui else {"path", "sha256", "distributions"}
    exact_keys(value, keys, "lock")
    if not isinstance(value["path"], str) or not value["path"] or not is_sha(value["sha256"], 64):
        raise RuntimeError("trusted success status lock content mismatch")
    if not ui:
        distributions = value["distributions"]
        if not isinstance(distributions, dict) or not distributions:
            raise RuntimeError("trusted success status lock distribution mismatch")
        for name, item in distributions.items():
            exact_keys(item, {"version", "artifact_hashes"}, "lock distribution")
            if not isinstance(name, str) or not name or not isinstance(item["version"], str):
                raise RuntimeError("trusted success status lock distribution content mismatch")
            hashes = item["artifact_hashes"]
            if not isinstance(hashes, list) or not hashes or len(set(hashes)) != len(hashes):
                raise RuntimeError("trusted success status lock hashes mismatch")
            if not all(is_sha(digest, 64) for digest in hashes):
                raise RuntimeError("trusted success status lock hashes malformed")


