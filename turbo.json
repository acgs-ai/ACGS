{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    "tsconfig*.json",
    ".env.example",
    "pyproject.toml",
    "pnpm-lock.yaml"
  ],
  "globalEnv": ["NODE_ENV", "CI"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".vite/**", "build/**", ".vercel/output/**"],
      "inputs": [
        "src/**",
        "public/**",
        "index.html",
        "package.json",
        "tsconfig*.json",
        "vite.config.*",
        "biome.json",
        "tailwind.theme.json",
        "tokens.json"
      ]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"],
      "inputs": [
        "src/**",
        "tests/**",
        "test/**",
        "package.json",
        "tsconfig*.json"
      ]
    },
    "lint": {
      "outputs": [],
      "inputs": [
        "src/**",
        "package.json",
        "biome.json",
        "eslint.config.js",
        "tsconfig*.json"
      ]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": [],
      "inputs": ["src/**", "tsconfig*.json", "package.json"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false
    }
  }
}
