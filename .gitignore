# Environment files
.env
.env.*
!.env.example
!.env.sample

# Dependencies
node_modules/
# This is a pnpm workspace — pnpm-lock.yaml is the only JS lockfile that
# should ever land in the parent. package-lock.json (npm) and yarn.lock
# slip in when someone runs `npm install` inside a workspace member; they
# split resolution and break `pnpm install --frozen-lockfile`. Ignore both.
package-lock.json
yarn.lock
__pycache__/
*.pyc
*.pyo
.venv/
venv/
env/
.eggs/
*.egg-info/
dist/
build/
target/

# Rust
target/
Cargo.lock
*.rlib
*.rmeta

# C / C++
*.o
*.a
*.so
*.dylib
*.dll
*.out
*.elf
CMakeFiles/
cmake_install.cmake
CMakeCache.txt
Makefile.cmake

# Large asset directories
separated_32_images/

# Hardening sprint evidence — generated per-run, not checked in.
artifacts/

# Turborepo cache
.turbo/

# Secrets / credentials
*.pem
*.key
*.p12
*.pfx
secrets/
credentials/
.gstack/

# Agent / harness scratch — never tracked at this level.
# Patterns without trailing slash match both files and directories.
.codex
.omc
# Project-level OMC skills are knowledge artifacts, not scratch state — keep them.
# Allow traversal into repo-root .omc/, ignore everything one level deep,
# then re-include skills/ specifically. Subdir .omc/ dirs (e.g.
# acgs_governance_eval_mvp/.omc/) remain fully ignored by the broad rule above.
!/.omc/
/.omc/*
!/.omc/skills/
!/.omc/skills/**
.remember
.omx
.claude

# Sibling projects — out of scope for this monorepo (each has its own home).
# Add explicitly so the working tree stays clean for tooling that gates on
# `git status --porcelain`. Re-include any of these by removing its line.
/ACGS/
/acgs-lite/
/ca-legal-agent-skills/
/clinicalguard-privacy-hardening/
/craft-agents-oss/
/eab-production-hardening/
/scheduled-todos-backup-2026-04-30/
/swarm-mesh-refactors-backup-2026-04-30/
