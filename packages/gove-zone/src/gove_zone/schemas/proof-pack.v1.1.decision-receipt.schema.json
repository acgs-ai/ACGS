{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://acgs.ai/schema/proof-pack/v1.1/decision-receipt.schema.json",
  "title": "ACGS proof pack v1.1 — decision-receipt.json artifact",
  "description": "The Decision Receipt carried verbatim inside an acgs/proof-pack/v1.1 bundle: the exact serialization of gove_zone.receipt.DecisionReceipt.to_dict(). receipt_hash is a SHA-256 over the canonical JSON of the bound fields; signature (when not 'unsigned_local') is an Ed25519 signature over receipt_hash. Frozen format: unknown keys are rejected. Unlike the frozen v1 counterpart, this v1.1 schema also admits the scoped-trust Decision Receipt v2 serialization, exactly as to_dict() emits it: receipt_schema_version, project_id, environment_id, and trust_epoch appear all-or-none (absent for receipt v1, all four present for 'gove-zone/decision-receipt/v2'). The two pack versions otherwise differ only in the summary-template revision bound to the pack's verification-summary.md; v1.1 ships as distinct schema files with distinct $id values instead of widening the frozen v1 schemas in place.",
  "type": "object",
  "properties": {
    "receipt_id": { "type": "string", "minLength": 1 },
    "request_id": { "type": "string" },
    "tenant_id": { "type": "string" },
    "actor": { "type": "string" },
    "subject": { "type": "string" },
    "proposed_action": { "type": "string" },
    "declared_goal": { "type": "string" },
    "execution_boundary": { "type": "string" },
    "policy_bundle_id": { "type": "string" },
    "policy_version": { "type": "string" },
    "policy_hash": { "type": "string" },
    "decision": { "enum": ["allow", "deny", "transform", "escalate"] },
    "matched_rules": { "type": "array", "items": { "type": "string" } },
    "constraints": { "type": "object" },
    "transformations": { "type": "array" },
    "approval_chain_summary": { "type": "object" },
    "timestamp": { "type": "string", "minLength": 1 },
    "expires_at": { "type": "string" },
    "authority": { "type": "string" },
    "validator_id": { "type": "string" },
    "validator_role": { "type": "string" },
    "argument_hash": { "$ref": "#/$defs/sha256" },
    "previous_audit_hash": { "$ref": "#/$defs/sha256" },
    "audit_event_hash": { "$ref": "#/$defs/sha256" },
    "signature_algorithm": { "type": "string", "minLength": 1 },
    "signing_key_id": { "type": "string" },
    "receipt_hash": { "$ref": "#/$defs/sha256" },
    "signature": { "type": "string", "minLength": 1 },
    "receipt_schema_version": { "const": "gove-zone/decision-receipt/v2" },
    "project_id": { "type": "string", "minLength": 1 },
    "environment_id": { "type": "string", "minLength": 1 },
    "trust_epoch": { "type": "integer", "minimum": 1 }
  },
  "required": [
    "receipt_id",
    "request_id",
    "tenant_id",
    "actor",
    "subject",
    "proposed_action",
    "declared_goal",
    "execution_boundary",
    "policy_bundle_id",
    "policy_version",
    "policy_hash",
    "decision",
    "matched_rules",
    "constraints",
    "transformations",
    "approval_chain_summary",
    "timestamp",
    "expires_at",
    "authority",
    "validator_id",
    "validator_role",
    "argument_hash",
    "previous_audit_hash",
    "audit_event_hash",
    "signature_algorithm",
    "signing_key_id",
    "receipt_hash",
    "signature"
  ],
  "additionalProperties": false,
  "dependentRequired": {
    "receipt_schema_version": ["project_id", "environment_id", "trust_epoch"],
    "project_id": ["receipt_schema_version"],
    "environment_id": ["receipt_schema_version"],
    "trust_epoch": ["receipt_schema_version"]
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
