{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://acgs.ai/schema/proof-pack/v1/replay-report.schema.json",
  "title": "ACGS proof pack v1 — replay-report.json artifact",
  "description": "The decision re-derivation report of an acgs/proof-pack/v1 bundle. status 'verified' is a generate-time attestation (the generator refuses to mint a pack from a failed replay, so a verified report always carries result.valid=true); status 'not_available' means no replay material was supplied and result is null. Frozen format: unknown keys are rejected.",
  "type": "object",
  "properties": {
    "schema_version": { "const": "acgs/proof-pack/v1" },
    "status": { "enum": ["verified", "not_available"] },
    "note": { "type": "string", "minLength": 1 },
    "result": {
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/replayResult" }]
    }
  },
  "required": ["schema_version", "status", "note", "result"],
  "additionalProperties": false,
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "verified" } }, "required": ["status"] },
      "then": {
        "properties": {
          "result": {
            "$ref": "#/$defs/replayResult",
            "properties": { "valid": { "const": true } }
          }
        }
      }
    },
    {
      "if": { "properties": { "status": { "const": "not_available" } }, "required": ["status"] },
      "then": { "properties": { "result": { "type": "null" } } }
    }
  ],
  "$defs": {
    "replayResult": {
      "type": "object",
      "properties": {
        "valid": { "type": "boolean" },
        "chain_valid": { "type": "boolean" },
        "events_total": { "type": "integer", "minimum": 0 },
        "events_matched": { "type": "integer", "minimum": 0 },
        "events_degraded": { "type": "integer", "minimum": 0 },
        "mismatches": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "event_id": { "type": ["string", "null"] },
              "type": { "type": "string" },
              "detail": {}
            },
            "required": ["event_id", "type", "detail"],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "valid",
        "chain_valid",
        "events_total",
        "events_matched",
        "events_degraded",
        "mismatches"
      ],
      "additionalProperties": false
    }
  }
}
