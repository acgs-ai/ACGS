{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://acgs.local/schemas/evidence/acgs-attestation-v1.schema.json",
  "title": "ACGS local Ed25519 attestation envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "algorithm",
    "mode",
    "key_id",
    "role",
    "principal",
    "parent_commit_sha",
    "product_commit_sha",
    "run_hash",
    "verdict",
    "timestamp_utc",
    "signature"
  ],
  "properties": {
    "schema_version": {"const": "acgs-attestation/v1"},
    "algorithm": {"const": "Ed25519"},
    "mode": {"enum": ["node-review", "node-verification", "claims-review"]},
    "key_id": {"type": "string", "pattern": "^ed25519:sha256:[0-9a-f]{64}$"},
    "role": {"enum": ["reviewer", "verifier", "claims-reviewer"]},
    "principal": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^\\s].*[^\\s]$|^[^\\s]$"},
    "parent_commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "product_commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "run_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "verdict": {"enum": ["approve", "reject"]},
    "timestamp_utc": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "signature": {"type": "string", "pattern": "^[A-Za-z0-9_-]{86}$"}
  },
  "allOf": [
    {
      "if": {"properties": {"mode": {"const": "node-review"}}, "required": ["mode"]},
      "then": {"properties": {"role": {"const": "reviewer"}}}
    },
    {
      "if": {"properties": {"mode": {"const": "node-verification"}}, "required": ["mode"]},
      "then": {"properties": {"role": {"const": "verifier"}}}
    },
    {
      "if": {"properties": {"mode": {"const": "claims-review"}}, "required": ["mode"]},
      "then": {"properties": {"role": {"const": "claims-reviewer"}}}
    }
  ]
}
