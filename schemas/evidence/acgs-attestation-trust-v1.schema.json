{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://acgs.local/schemas/evidence/acgs-attestation-trust-v1.schema.json",
  "title": "ACGS local attestation trust manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "trust_domain", "keys"],
  "properties": {
    "schema_version": {"const": "acgs-attestation-trust/v1"},
    "trust_domain": {"const": "acgs-saas-beta-local"},
    "keys": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {"$ref": "#/$defs/trustKey"}
    }
  },
  "$defs": {
    "trustKey": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key_id",
        "algorithm",
        "role",
        "principal",
        "public_key_base64url",
        "not_before_utc",
        "not_after_utc",
        "status"
      ],
      "properties": {
        "key_id": {"type": "string", "pattern": "^ed25519:sha256:[0-9a-f]{64}$"},
        "algorithm": {"const": "Ed25519"},
        "role": {"enum": ["reviewer", "verifier", "claims-reviewer"]},
        "principal": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^\\s].*[^\\s]$|^[^\\s]$"},
        "public_key_base64url": {"type": "string", "pattern": "^[A-Za-z0-9_-]{43}$"},
        "not_before_utc": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
        "not_after_utc": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
        "status": {"enum": ["trusted", "revoked"]}
      }
    }
  }
}
