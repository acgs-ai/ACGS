{
  "name": "acgi-ai",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "design:lint": "npx -y @google/design.md lint DESIGN.md",
    "design:check": "python scripts/check-design-tokens.py",
    "design:export:tailwind": "npx -y @google/design.md export --format tailwind DESIGN.md > tailwind.theme.json",
    "design:export:dtcg": "npx -y @google/design.md export --format dtcg DESIGN.md > tokens.json",
    "design:export": "pnpm design:export:tailwind && pnpm design:export:dtcg",
    "lint": "biome check src index.html package.json vite.config.ts tsconfig.json tsconfig.app.json tsconfig.node.json biome.json",
    "format": "biome format --write src index.html package.json vite.config.ts tsconfig.json tsconfig.app.json tsconfig.node.json biome.json",
    "test:security": "node scripts/check-security-invariants.mjs",
    "test:mvp": "node scripts/check-gove-zone-mvp.mjs",
    "evidence:build": "node scripts/build-buyer-evidence.mjs",
    "storybook:build": "pnpm run evidence:build",
    "test:buyer-evidence": "node scripts/check-buyer-evidence-artifact.mjs",
    "test:storybook-runtime-plan": "node scripts/check-storybook-runtime-plan.mjs",
    "test:storybook-publication": "node scripts/check-storybook-publication.mjs",
    "build:hosted-storybook-handoff": "node scripts/build-hosted-storybook-handoff.mjs",
    "test:hosted-storybook-handoff": "node scripts/check-hosted-storybook-handoff.mjs",
    "test:hosted-storybook-proof-template": "node scripts/check-hosted-storybook-proof-template.mjs",
    "validate:hosted-storybook-proof": "node scripts/validate-hosted-storybook-proof.mjs",
    "test:hosted-storybook-proof-gap-report": "node scripts/check-hosted-storybook-proof-gap-report.mjs",
    "build:hosted-storybook-proof-gap-report": "node scripts/build-hosted-storybook-proof-gap-report.mjs",
    "test:production-live-verifier": "node scripts/check-production-live-verifier.mjs",
    "test:ci-gates": "node scripts/check-ci-readiness-gates.mjs",
    "smoke:gove-zone-live": "node scripts/smoke-gove-zone-live.mjs",
    "test:all": "pnpm run lint && pnpm run build && pnpm run test:security && pnpm run test:mvp && pnpm run test:buyer-evidence && pnpm run test:storybook-runtime-plan && pnpm run test:storybook-publication && pnpm run test:hosted-storybook-handoff && pnpm run test:hosted-storybook-proof-template && pnpm run test:hosted-storybook-proof-gap-report",
    "build:console": "tsc -b && vite build --mode console",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:playwright": "playwright test --config=playwright.config.ts",
    "preview": "vite preview",
    "test:production-evidence-template": "node scripts/check-production-evidence-template.mjs",
    "validate:production-evidence": "node scripts/validate-production-evidence.mjs",
    "test:production-evidence-validator": "node scripts/check-production-evidence-validator.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.100.8",
    "@tanstack/react-router": "^1.169.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.14.0",
    "motion": "^12.38.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-error-boundary": "^6.1.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.14",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/vite": "^4.2.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.7",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "jsdom": "^29.1.1",
    "msw": "^2.14.2",
    "tailwindcss": "^4.2.4",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.10",
    "vitest": "^4.1.7"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
