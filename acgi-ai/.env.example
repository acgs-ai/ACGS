# Set to "true" to intercept /api/v1/* with MSW handlers (src/mocks/handlers.ts).
# Set to anything else (or unset) to fall through to the Vite proxy below.
VITE_USE_MOCKS=true

# Where the dev Vite server proxies /api/v1/* when MSW is off.
# In production this is irrelevant — Caddy on console.acgs.ai reverse-proxies
# the same prefix to the gateway (see DEPLOY.md §3, §7).
VITE_API_PROXY_TARGET=http://localhost:8080
