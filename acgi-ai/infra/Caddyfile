# Console origin — DEPLOY.md §4.
#
# This Caddyfile is tuned for Cloud Run / Fly.io: TLS is terminated upstream
# (the platform's load balancer), so we listen on $PORT plain HTTP and emit
# the security headers ourselves. For a self-hosted deploy that owns its own
# cert, replace `:{$PORT:8080}` with the hostname and Caddy will obtain a
# Let's Encrypt cert via ACME.

{
  # Disable the admin endpoint — we don't expose runtime config in production.
  admin off
  # Don't write a redundant Server: header.
  servers {
    metrics
  }
  auto_https off
}

:{$PORT:8080} {
  encode zstd gzip

  # ── Static assets — Vite emits hashed filenames; cache forever.
  @assets path /assets/*
  header @assets Cache-Control "public, max-age=31536000, immutable"

  # ── Self-hosted fonts — DESIGN.md §7.1 / DEPLOY.md §6.
  #    Same-origin only; no CORS allowance because the marketing surface
  #    loads fonts from a different provider entirely.
  @fonts path /static/fonts/*.woff2
  header @fonts Cache-Control "public, max-age=31536000, immutable"

  # ── Privileged HTML — never cache the entry document. The bundle hash in
  #    /assets/* is what carries the cache key; index.html must always be
  #    a fresh fetch so a constitution change is visible immediately.
  @html path / /index.html
  header @html Cache-Control "no-store, no-cache, must-revalidate, max-age=0"

  # ── Internal docs blocklist. Vite copies public/ verbatim into dist/, so
  #    AGENTS.md files placed for in-repo agent navigation would otherwise be
  #    web-reachable on the privileged origin. DEPLOY.md §4: nothing internal
  #    leaves the audit-trail surface. Defense in depth — the source of truth
  #    is "don't put docs in public/", this rule guarantees the URL is dead
  #    even if one slips in.
  @internal_docs path *AGENTS.md *CLAUDE.md *DESIGN.md *DEPLOY.md

  # ── Privileged console routes — DEPLOY.md §7. Deep links must not be
  #    served directly by the SPA fallback unless the deployment supplies a
  #    real edge/session authorizer. AUTH_UPSTREAM intentionally falls back to
  #    a closed localhost port so missing auth config fails closed.
  @console_routes path /console /console/*

  # ── Security headers — DEPLOY.md §5.
  header {
    Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
    X-Content-Type-Options    "nosniff"
    X-Frame-Options           "DENY"
    Referrer-Policy           "no-referrer"
    Permissions-Policy        "camera=(), microphone=(), geolocation=(), interest-cohort=()"
    Cross-Origin-Opener-Policy   "same-origin"
    Cross-Origin-Resource-Policy "same-origin"
    # Strict CSP — no 'unsafe-inline' anywhere. JSX inline styles eliminated
    # in favour of utility/component classes (src/csp-utilities.css). See
    # DEPLOY.md §5 for the rationale.
    Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests"
    # Don't advertise the server.
    -Server
  }

  root * /srv/dist

  # ── Request routing. Caddy normally sorts directives by type; the route
  #    block preserves this order so /api/* reaches reverse_proxy before the
  #    SPA try_files fallback can rewrite it to /index.html.
  route {
    # ── Health endpoint — DEPLOY.md §10. Reports the constitution hash that
    #    the bundle was compiled against plus the deployed build id. The
    #    runtime constitution lives in the bus; this is the *served* hash,
    #    used to detect drift between the static bundle and the bus.
    handle /healthz {
      header Content-Type "application/json"
      respond `{"ok":true,"served_hash":"608508a9bd224290","build_id":"{$ACGI_BUILD_ID:local}","surface":"console"}` 200
    }

    # ── API reverse proxy — Phase 5 bus-readiness gate (PLAN.md §5.5).
    #    BUS_UPSTREAM must point at the governed bus/gateway. If it is not set,
    #    the fallback points at a closed localhost port so production fails
    #    closed with a proxy error rather than rendering fixture data. The schema
    #    version header is forwarded and echoed for contract-handshake evidence.
    handle /api/* {
      reverse_proxy {$BUS_UPSTREAM:127.0.0.1:65535} {
        header_up X-ACGS-Schema-Version "{$ACGS_SCHEMA_VERSION:v1}"
        header_down X-ACGS-Schema-Version "{$ACGS_SCHEMA_VERSION:v1}"
        lb_try_duration 2s
        lb_try_interval 250ms
      }
    }

    handle @internal_docs {
      respond 404
    }

    # ── Edge auth for console deep links. The upstream owns OIDC/server-cookie
    #    verification and returns 2xx only for authorized sessions; non-2xx
    #    responses are returned before the SPA fallback can serve /console/*.
    handle @console_routes {
      forward_auth {$AUTH_UPSTREAM:127.0.0.1:65535} {
        uri /authorize
        copy_headers X-ACGS-Operator X-ACGS-Tenant X-ACGS-Auth-Context
      }
      try_files {path} /index.html
      file_server
    }

    # ── Static file serving with SPA fallback for the TanStack Router route
    #    tree. Any path that doesn't resolve to a file gets index.html so
    #    public/product deep links work. /console/* is handled above by the
    #    fail-closed auth gate.
    handle {
      try_files {path} /index.html
      file_server
    }
  }

  # ── Access log — JSON, one event per request. DEPLOY.md §10 forwards
  #    these into the same audit sink the bus uses.
  log {
    output stdout
    format json
    level INFO
  }
}
